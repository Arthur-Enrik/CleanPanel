<ui:FluentWindow x:Class="HardwareOverlayApp.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:HardwareOverlayApp.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="CleanPanel"
                 Width="1020"
                 Height="700"
                 MinWidth="800"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Display, Segoe UI"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título limpa integrada à estética monocromática -->
        <ui:TitleBar Grid.Row="0"
                     Title="CleanPanel"
                     Height="36"
                     Foreground="{DynamicResource TextSecondaryBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                              Width="16"
                              Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Estrutura Principal: Barra Lateral Fixa Minimalista + Área de Conteúdo Responsiva -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== BARRA LATERAL FIXA (200px) ==================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,14,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Topo: Logo minimalista CleanPanel + Versão -->
                    <Grid Grid.Row="0" Margin="4,0,4,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Emblema Geométrico Minimalista -->
                        <Border Grid.Column="0"
                                Width="22"
                                Height="22"
                                CornerRadius="5"
                                Background="{DynamicResource AccentPrimaryBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <Grid Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="3" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="1" Background="{DynamicResource AccentForegroundBrush}" />
                                <Border Width="3" Height="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="1" Background="{DynamicResource AccentForegroundBrush}" />
                                <Border Width="3" Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" CornerRadius="1" Background="{DynamicResource AccentForegroundBrush}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="CleanPanel"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="v1.1.0"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </Grid>

                    <!-- Navegação Principal -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="TELEMETRIA"
                                   Style="{StaticResource MicroLabelStyle}"
                                   Margin="10,0,0,8" />

                        <!-- 1. Visão Geral -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsOverviewTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataHistogram24"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Visão Geral"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Processador -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsCpuTabSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="DeveloperBoard24"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Processador"
                                           Margin="10,0,4,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding CpuLoadText}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <!-- 3. Placa de Vídeo -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsGpuTabSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Video24"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Placa de Vídeo"
                                           Margin="10,0,4,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding GpuLoadText}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <!-- 4. Sistema & Discos -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsStorageTabSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="HardDrive20"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Sistema &amp; Discos"
                                           Margin="10,0,4,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RamPercentText}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!-- Rodapé da Barra Lateral: Configurações + Status do Overlay -->
                    <StackPanel Grid.Row="2">
                        <Border Height="1"
                                Background="{DynamicResource BorderSubtleBrush}"
                                Margin="2,8,2,10" />

                        <!-- 5. Configurações -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsSettingsTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Configurações"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Status Sutil do Overlay com Toggle Rápido -->
                        <Border Style="{StaticResource SubCardBorderStyle}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Padding="10,8"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverlayStatusText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding FpsText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="13.5"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Ativar / Ocultar Overlay Flutuante"
                                                 IsChecked="{Binding IsOverlayVisible, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ÁREA DE CONTEÚDO RESPONSIVA ==================== -->
            <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">

                <!-- ======================================================================= -->
                <!-- 1. ABA "VISÃO GERAL"                                                    -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsOverviewTabSelected, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,20,24,24">
                    <StackPanel>
                        <TextBlock Text="Visão Geral do Sistema"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Telemetria em tempo real de processador, placa de vídeo, memória e desempenho"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,18" />

                        <!-- KPI Summary Cards (Grid Responsivo de 4 Colunas) -->
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <!-- KPI CPU -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="PROCESSADOR" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding CpuLoadText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding CpuShortName}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10" />
                                    <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                 Value="{Binding CpuLoadBarValue, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI GPU -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding GpuLoadText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding GpuShortName}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10" />
                                    <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                 Value="{Binding SelectedGpu.CoreLoadBarValue, FallbackValue=0, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI RAM -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding RamPercentText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding RamUsedText}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10" />
                                    <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                 Value="{Binding RamUsageBarValue, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI FPS -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TAXA DE QUADROS" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding FpsValueText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               Margin="0,6,0,2" />
                                    <TextBlock Text="FPS (ETW em tempo real)"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- CARD: SISTEMA OPERACIONAL -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource SubCardBorderStyle}"
                                        Width="38"
                                        Height="38"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                    <ui:SymbolIcon Symbol="Window24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SISTEMA OPERACIONAL" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding OsName}"
                                               FontSize="15.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,2,0,2" />
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Edição: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding OsEdition}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="  •  Build: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding OsBuild}" FontFamily="Consolas" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SubCardBorderStyle}"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FpsText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="13" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CARD: PROCESSADOR (CPU) -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SubCardBorderStyle}"
                                            Width="38"
                                            Height="38"
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                        <ui:SymbolIcon Symbol="DeveloperBoard24"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="PROCESSADOR (CPU)" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding CpuName}"
                                                   FontSize="15.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,2" />
                                        <TextBlock Text="{Binding CpuCoresThreadsSummary}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SubCardBorderStyle}" Padding="10,6" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="USO" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                                <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource TabularValueStyle}" FontSize="14" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SubCardBorderStyle}" Padding="10,6">
                                            <StackPanel>
                                                <TextBlock Text="TEMP" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                                <TextBlock Text="{Binding CpuTemperatureText}" Style="{StaticResource TabularValueStyle}" FontSize="14" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                             Margin="0,12,0,0"
                                             Value="{Binding CpuLoadBarValue, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- CARD: PLACAS DE VÍDEO (MULTI-GPU) -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="Video24"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="PLACAS DE VÍDEO (GPU)"
                                               Style="{StaticResource MicroLabelStyle}"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2"
                                            Style="{StaticResource SubCardBorderStyle}"
                                            CornerRadius="4"
                                            Padding="8,2">
                                        <TextBlock Text="{Binding GpuCountBadgeText}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Gpus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="VRAM: " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock Text="{Binding TotalVramDisplay}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="10,5"
                                                                    Margin="0,0,6,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="USO" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                                                    <TextBlock Text="{Binding CoreLoadText}" Style="{StaticResource TabularValueStyle}" FontSize="13.5" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="10,5">
                                                                <StackPanel>
                                                                    <TextBlock Text="TEMP" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                                                    <TextBlock Text="{Binding CoreTemperatureText}" Style="{StaticResource TabularValueStyle}" FontSize="13.5" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                                 Background="{DynamicResource CardBackgroundBrush}"
                                                                 Margin="0,10,0,0"
                                                                 Value="{Binding CoreLoadBarValue, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- CARD: MEMÓRIA RAM -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SubCardBorderStyle}"
                                            Width="38"
                                            Height="38"
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                        <ui:SymbolIcon Symbol="Ram16"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding RamDetailedSummaryText}"
                                                   FontSize="14.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,3" />
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="Total: " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding RamTotalText}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                            <TextBlock Text="Usada: " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding RamUsedText}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                            <TextBlock Text="Livre: " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding RamFreeText}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource SubCardBorderStyle}" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="OCUPAÇÃO" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                            <TextBlock Text="{Binding RamPercentText}" Style="{StaticResource TabularValueStyle}" FontSize="14.5" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                             Margin="0,12,0,0"
                                             Value="{Binding RamUsageBarValue, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- CARD: ARMAZENAMENTO -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="HardDrive20"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                    <TextBlock Text="UNIDADES DE ARMAZENAMENTO"
                                               Style="{StaticResource MicroLabelStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding StorageDrives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding PhysicalDiskModel}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,1,0,2" />
                                                            <TextBlock Text="{Binding OverviewLineText}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="10,4"
                                                                VerticalAlignment="Center">
                                                            <StackPanel>
                                                                <TextBlock Text="TEMP" Style="{StaticResource MicroLabelStyle}" FontSize="9" />
                                                                <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource TabularValueStyle}" FontSize="12.5" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                                 Background="{DynamicResource CardBackgroundBrush}"
                                                                 Margin="0,8,0,0"
                                                                 Value="{Binding UsagePercent, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 2. ABA "PROCESSADOR" (DETALHES AVANÇADOS & P/E CORES)                   -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsCpuTabSelected, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,20,24,24">
                    <StackPanel>
                        <TextBlock Text="Processador (CPU)"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Especificações físicas, sensores globais de energia/tensão e telemetria individual por núcleo"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,18" />

                        <!-- Especificações do Processador -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="MODELO DO PROCESSADOR" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding CpuName}"
                                               FontSize="16.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,2" />
                                    <TextBlock Text="{Binding CpuCoresThreadsSummary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Style="{StaticResource SubCardBorderStyle}"
                                        Padding="12,8"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="NÚCLEOS FÍSICOS" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                        <TextBlock Text="{Binding CpuPhysicalCores}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SubCardBorderStyle}"
                                        Padding="12,8"
                                        VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="THREADS LÓGICOS" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                        <TextBlock Text="{Binding CpuLogicalThreads}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Métricas Globais: Linha 1 -->
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="USO TOTAL DA CPU" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding CpuLoadText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               Margin="0,4,0,8" />
                                    <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                 Value="{Binding CpuLoadBarValue, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="3,0,3,12">
                                <StackPanel>
                                    <TextBlock Text="TEMPERATURA (PACKAGE)" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding CpuTemperatureText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Sensor térmico principal"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CONSUMO ELÉTRICO" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding CpuPowerText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Potência do pacote em watts"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Métricas Globais: Linha 2 -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="TENSÃO DO NÚCLEO (VCORE / VID)" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding CpuVoltageText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="20"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Leitura direta CPU / SuperIO da placa-mãe"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="FREQUÊNCIA (CLOCK MÉDIO / MÁXIMO)" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="{Binding CpuClockAvgMaxText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="18"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Frequência operacional dos núcleos ativos"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Telemetria Individual por Núcleo / Thread (incluindo tags P-Core / E-Core) -->
                        <TextBlock Text="TELEMETRIA POR NÚCLEO / THREAD"
                                   Style="{StaticResource MicroLabelStyle}"
                                   Margin="0,2,0,10" />

                        <ItemsControl ItemsSource="{Binding CpuCores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CoreName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ClockText}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding LoadText}"
                                                           Style="{StaticResource TabularValueStyle}"
                                                           FontSize="12.5"
                                                           Width="42"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                         Margin="0,7,0,0"
                                                         Value="{Binding LoadBarValue, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 3. ABA "PLACA DE VÍDEO" (MULTI-GPU E SENSORES AVANÇADOS)                -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsGpuTabSelected, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,20,24,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Placa de Vídeo (GPU)"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Suporte Multi-GPU com telemetria de Core, Hot Spot, Clocks, VRAM, Energia e Ventoinhas"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource SubCardBorderStyle}"
                                    Padding="10,5"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuCountBadgeText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- Seletor Multi-GPU -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="ADAPTADOR GRÁFICO (GPU)" Style="{StaticResource MicroLabelStyle}" />
                                    <TextBlock Text="Alterne entre GPUs dedicadas e integradas"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Gpus}"
                                          SelectedItem="{Binding SelectedGpu, Mode=TwoWay}"
                                          DisplayMemberPath="DisplaySelectorTitle"
                                          VerticalAlignment="Center"
                                          FontSize="13"
                                          FontWeight="Medium" />
                            </Grid>
                        </Border>

                        <!-- Telemetria da GPU Selecionada -->
                        <StackPanel DataContext="{Binding SelectedGpu}">
                            <Border Style="{StaticResource TelemetryCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Vendor}" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource SubCardBorderStyle}"
                                            Padding="12,7"
                                            VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="VRAM TOTAL" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                            <TextBlock Text="{Binding TotalVramDisplay}"
                                                       Style="{StaticResource TabularValueStyle}"
                                                       FontSize="14.5" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Linha 1: Uso Core & Uso VRAM -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                    <StackPanel>
                                        <TextBlock Text="USO DO CORE (GPU LOAD)" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding CoreLoadText}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="22"
                                                   Margin="0,4,0,8" />
                                        <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                     Value="{Binding CoreLoadBarValue, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="MEMÓRIA DE VÍDEO (VRAM)" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding VramUsageText}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="17"
                                                   Margin="0,7,0,10" />
                                        <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                     Value="{Binding VramUsagePercent, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Linha 2: Temperaturas e Clocks -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TEMP CORE" Style="{StaticResource MicroLabelStyle}" />
                                            <TextBlock Text="{Binding CoreTemperatureText}"
                                                       Style="{StaticResource TabularValueStyle}"
                                                       FontSize="20"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TEMP HOT SPOT" Style="{StaticResource MicroLabelStyle}" />
                                            <TextBlock Text="{Binding HotSpotTemperatureText}"
                                                       Style="{StaticResource TabularValueStyle}"
                                                       FontSize="20"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CLOCK CORE" Style="{StaticResource MicroLabelStyle}" />
                                            <TextBlock Text="{Binding CoreClockText}"
                                                       Style="{StaticResource TabularValueStyle}"
                                                       FontSize="18"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CLOCK MEMÓRIA" Style="{StaticResource MicroLabelStyle}" />
                                            <TextBlock Text="{Binding MemoryClockText}"
                                                       Style="{StaticResource TabularValueStyle}"
                                                       FontSize="18"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- Linha 3: Consumo & Fans -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                    <StackPanel>
                                        <TextBlock Text="CONSUMO DA GPU (BOARD POWER)" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding PowerText}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="20"
                                                   Margin="0,4,0,2" />
                                        <TextBlock Text="Leitura do sensor de potência da placa"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="VELOCIDADE DOS FANS" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding FanText}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="20"
                                                   Margin="0,4,0,2" />
                                        <TextBlock Text="Rotação RPM / % ou Fan Stop"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 4. ABA "SISTEMA & DISCOS"                                               -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsStorageTabSelected, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,20,24,24">
                    <StackPanel>
                        <TextBlock Text="Sistema &amp; Discos"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Ocupação de Memória RAM, partições lógicas do Windows e temperatura física de SSDs/HDDs"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,18" />

                        <!-- Memória RAM Detalhada -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="MEMÓRIA RAM FÍSICA" Style="{StaticResource MicroLabelStyle}" />
                                        <TextBlock Text="{Binding RamDetailedSummaryText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RamPercentText}"
                                               Style="{StaticResource TabularValueStyle}"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                             Margin="0,12,0,12"
                                             Value="{Binding RamUsageBarValue, Mode=OneWay}" />

                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource SubCardBorderStyle}" Padding="10,8" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL INSTALADO" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                            <TextBlock Text="{Binding RamTotalText}" Style="{StaticResource TabularValueStyle}" FontSize="14.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubCardBorderStyle}" Padding="10,8" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="EM USO" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                            <TextBlock Text="{Binding RamUsedText}" Style="{StaticResource TabularValueStyle}" FontSize="14.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubCardBorderStyle}" Padding="10,8" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DISPONÍVEL" Style="{StaticResource MicroLabelStyle}" FontSize="9.5" />
                                            <TextBlock Text="{Binding RamFreeText}" Style="{StaticResource TabularValueStyle}" FontSize="14.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Partições Lógicas -->
                        <TextBlock Text="PARTIÇÕES E TEMPERATURA FÍSICA"
                                   Style="{StaticResource MicroLabelStyle}"
                                   Margin="0,6,0,10" />

                        <ItemsControl ItemsSource="{Binding StorageDrives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TelemetryCardBorderStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Style="{StaticResource SubCardBorderStyle}"
                                                        Width="38"
                                                        Height="38"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0">
                                                    <ui:SymbolIcon Symbol="HardDrive20"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="14.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Border Style="{StaticResource SubCardBorderStyle}"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileSystem}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PhysicalDiskModel}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Style="{StaticResource SubCardBorderStyle}"
                                                        Padding="12,5"
                                                        VerticalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="TEMPERATURA" Style="{StaticResource MicroLabelStyle}" FontSize="9" />
                                                        <TextBlock Text="{Binding TemperatureText}"
                                                                   Style="{StaticResource TabularValueStyle}"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <ProgressBar Style="{StaticResource MonoProgressBarStyle}"
                                                         Margin="0,12,0,8"
                                                         Value="{Binding UsagePercent, Mode=OneWay}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CapacitySummaryText}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FreeSpaceSummaryText}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sensores Físicos SMART -->
                        <TextBlock Text="DISCOS FÍSICOS (SENSORES SMART)"
                                   Style="{StaticResource MicroLabelStyle}"
                                   Margin="0,6,0,10" />

                        <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TelemetryCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Grid.Column="0"
                                                           Symbol="HardDrive20"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding ModelName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Unidade física detectada pelo LibreHardwareMonitor"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="12,5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TemperatureText}"
                                                           Style="{StaticResource TabularValueStyle}"
                                                           FontSize="13.5" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 5. ABA "CONFIGURAÇÕES" (WEB SETTINGS COM 3 SUB-ABAS + MAXWIDTH 780)     -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsSettingsTabSelected, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,20,24,28">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
                        <TextBlock Text="Configurações"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Preferências do aplicativo, comportamento do Overlay em jogos e seleção de sensores"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,16" />

                        <!-- Barra Horizontal das 3 Sub-Abas -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6"
                                Margin="0,0,0,20">
                            <WrapPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SubTabRadioButtonStyle}"
                                             GroupName="SettingsSubTabs"
                                             Content="Geral &amp; Sistema"
                                             IsChecked="{Binding IsSettingsGeneralSubTabSelected, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SubTabRadioButtonStyle}"
                                             GroupName="SettingsSubTabs"
                                             Content="Overlay &amp; Layout"
                                             IsChecked="{Binding IsSettingsOverlaySubTabSelected, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SubTabRadioButtonStyle}"
                                             GroupName="SettingsSubTabs"
                                             Content="Sensores &amp; Ordem"
                                             Margin="0"
                                             IsChecked="{Binding IsSettingsSensorsSubTabSelected, Mode=TwoWay}" />
                            </WrapPanel>
                        </Border>

                        <!-- ==================== SUB-ABA 1: GERAL & SISTEMA ==================== -->
                        <StackPanel Visibility="{Binding IsSettingsGeneralSubTabSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SISTEMA E APARÊNCIA"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,0,0,8" />

                            <!-- Iniciar com o Windows -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Iniciar com o Windows"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Inicia minimizado na bandeja do sistema como Administrador via Agendador de Tarefas"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- 1. Atalho Global para Exibir / Ocultar Overlay -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Atalho para Exibir / Ocultar Overlay"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Clique para gravar uma combinação (ex: Ctrl + Shift + O) e pressione Esc para cancelar"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Visibility="{Binding HasOverlayHotkeyError, Converter={StaticResource BoolToVis}}"
                                                   Text="{Binding OverlayHotkeyErrorText}"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Opacity="0.85"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button MinWidth="150"
                                                FontFamily="Consolas"
                                                FontWeight="Bold"
                                                FontSize="12"
                                                Content="{Binding OverlayHotkeyDisplayText}"
                                                ToolTip="Clique para gravar um novo atalho global"
                                                Command="{Binding StartRecordingOverlayHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MonoActionButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecordingOverlayHotkey}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="&#x21BA;"
                                                FontSize="13"
                                                Padding="9,5"
                                                Margin="6,0,0,0"
                                                ToolTip="Restaurar padrão (Ctrl + Shift + O)"
                                                Command="{Binding ResetOverlayHotkeyCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. Atalho Global para Modo Compacto -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Atalho para Modo Compacto"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Alterna instantaneamente entre o modo completo e compacto (padrão: Ctrl + Shift + C)"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Visibility="{Binding HasCompactHotkeyError, Converter={StaticResource BoolToVis}}"
                                                   Text="{Binding CompactHotkeyErrorText}"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Opacity="0.85"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button MinWidth="150"
                                                FontFamily="Consolas"
                                                FontWeight="Bold"
                                                FontSize="12"
                                                Content="{Binding CompactHotkeyDisplayText}"
                                                ToolTip="Clique para gravar um novo atalho global"
                                                Command="{Binding StartRecordingCompactHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MonoActionButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecordingCompactHotkey}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="&#x21BA;"
                                                FontSize="13"
                                                Padding="9,5"
                                                Margin="6,0,0,0"
                                                ToolTip="Restaurar padrão (Ctrl + Shift + C)"
                                                Command="{Binding ResetCompactHotkeyCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tema da Interface (Escuro, Claro, Automático) -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Tema da Interface"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Alterna entre modo Escuro, Claro ou segue automaticamente a preferência do Windows"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource OptionPillRadioButtonStyle}"
                                                     GroupName="AppThemeGroup"
                                                     Content="Escuro"
                                                     Margin="0"
                                                     IsChecked="{Binding IsThemeDarkSelected, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource OptionPillRadioButtonStyle}"
                                                     GroupName="AppThemeGroup"
                                                     Content="Claro"
                                                     IsChecked="{Binding IsThemeLightSelected, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource OptionPillRadioButtonStyle}"
                                                     GroupName="AppThemeGroup"
                                                     Content="Automático"
                                                     IsChecked="{Binding IsThemeAutoSelected, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="AÇÕES DO APLICATIVO"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,14,0,8" />

                            <!-- Encerrar CleanPanel -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Encerrar Aplicativo"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Fechar a janela no 'X' apenas minimiza para a bandeja. Use o botão ao lado para encerrar os serviços"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource MonoActionButtonStyle}"
                                            Content="Encerrar CleanPanel"
                                            VerticalAlignment="Center"
                                            Command="{Binding ExitApplicationCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== SUB-ABA 2: OVERLAY & LAYOUT ==================== -->
                        <StackPanel Visibility="{Binding IsSettingsOverlaySubTabSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="VISIBILIDADE E COMPORTAMENTO"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,0,0,8" />

                            <!-- Ativar / Ocultar Overlay -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Ativar / Ocultar Overlay"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Controla a exibição da janela flutuante monocromática sobre a tela"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding IsOverlayVisible, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Modo de Exibição Inteligente -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Modo de Exibição Inteligente — Apenas em Tela Cheia"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Oculta automaticamente na área de trabalho ou em janelas maximizadas e exibe apenas em aplicações Fullscreen"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding SmartFullscreenOnly, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Travar Overlay / Click-Through -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Travar Overlay (Modo Click-Through)"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Permite que cliques do mouse atravessem o Overlay diretamente para o jogo; destrave para arrastar livremente"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding IsOverlayLocked, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Modo Compacto -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Modo Compacto"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Exibe apenas CPU %, GPU % e FPS em formato ultra enxuto, alternando automaticamente para a orientação horizontal"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding IsCompactMode, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Orientação do Overlay -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Orientação do Overlay"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Escolha entre coluna vertical agrupada por hardware ou barra horizontal em linha"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource OptionPillRadioButtonStyle}"
                                                     GroupName="OverlayLayoutGroup"
                                                     Content="Vertical"
                                                     Margin="0"
                                                     IsChecked="{Binding IsVerticalLayout, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource OptionPillRadioButtonStyle}"
                                                     GroupName="OverlayLayoutGroup"
                                                     Content="Horizontal"
                                                     IsChecked="{Binding IsHorizontalLayout, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="DIMENSÃO, OPACIDADE E POSIÇÃO"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,14,0,8" />

                            <!-- Tamanho / Escala do Overlay (70% a 200%) -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Tamanho / Escala do Overlay"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Ajusta proporcionalmente textos, títulos e borda do card (70% a 200%)"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Minimum="0.70"
                                                Maximum="2.00"
                                                SmallChange="0.05"
                                                LargeChange="0.10"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                Width="140"
                                                VerticalAlignment="Center"
                                                Value="{Binding OverlayScale, Mode=TwoWay}" />
                                        <TextBlock Text="{Binding OverlayScalePercentText}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="12.5"
                                                   Width="44"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,10,0" />
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Resetar (100%)"
                                                Command="{Binding ResetOverlayScaleCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Opacidade do Fundo do Overlay (10% a 100%) -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Opacidade do Fundo do Overlay"
                                                   FontWeight="Medium"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Controla a transparência do fundo preto fosco (#09090B) mantendo os textos 100% legíveis"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Minimum="0.10"
                                                Maximum="1.00"
                                                SmallChange="0.05"
                                                LargeChange="0.10"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="False"
                                                Width="160"
                                                VerticalAlignment="Center"
                                                Value="{Binding OverlayOpacity, Mode=TwoWay}" />
                                        <TextBlock Text="{Binding OverlayOpacityPercentText}"
                                                   Style="{StaticResource TabularValueStyle}"
                                                   FontSize="12.5"
                                                   Width="44"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Posição / Local na Tela -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,0,8" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Posição / Local na Tela"
                                                       FontWeight="Medium"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Alinhe rapidamente o Overlay em uma das 6 posições ou arraste livremente quando destravado"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Resetar Posição (50, 50)"
                                                VerticalAlignment="Center"
                                                Command="{Binding ResetPositionCommand}" />
                                    </Grid>

                                    <UniformGrid Columns="3" Rows="2">
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Superior Esquerdo"
                                                Margin="0,0,6,6"
                                                Command="{Binding AlignOverlayCommand}"
                                                CommandParameter="TopLeft" />
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Superior Centro"
                                                Margin="3,0,3,6"
                                                Command="{Binding AlignOverlayCommand}"
                                                CommandParameter="TopCenter" />
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Superior Direito"
                                                Margin="6,0,0,6"
                                                Command="{Binding AlignOverlayCommand}"
                                                CommandParameter="TopRight" />
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Inferior Esquerdo"
                                                Margin="0,0,6,0"
                                                Command="{Binding AlignOverlayCommand}"
                                                CommandParameter="BottomLeft" />
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Inferior Centro"
                                                Margin="3,0,3,0"
                                                Command="{Binding AlignOverlayCommand}"
                                                CommandParameter="BottomCenter" />
                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                Content="Inferior Direito"
                                                Margin="6,0,0,0"
                                                Command="{Binding AlignOverlayCommand}"
                                                CommandParameter="BottomRight" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== SUB-ABA 3: SENSORES & ORDEM ==================== -->
                        <StackPanel Visibility="{Binding IsSettingsSensorsSubTabSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="REORDENAÇÃO DOS BLOCOS NO OVERLAY"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,0,0,8" />

                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,0,16" Padding="14">
                                <ItemsControl ItemsSource="{Binding OverlaySections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="12,9"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource CardBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Width="28"
                                                            Height="28"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PositionNumber, StringFormat={}{0}º}"
                                                                   Style="{StaticResource TabularValueStyle}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontWeight="Medium"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Key, StringFormat=Bloco: {0}}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                                Content="▲"
                                                                Padding="10,4"
                                                                Margin="0,0,6,0"
                                                                ToolTip="Mover bloco para cima"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                Command="{Binding Parent.MoveOverlaySectionUpCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource MonoActionButtonStyle}"
                                                                Content="▼"
                                                                Padding="10,4"
                                                                ToolTip="Mover bloco para baixo"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                Command="{Binding Parent.MoveOverlaySectionDownCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Grupo CPU -->
                            <TextBlock Text="PROCESSADOR (CPU)"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,0,0,8" />

                            <!-- Separar P-Cores e E-Cores (Intel Híbrido) -->
                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="Separar Núcleos P-Core e E-Core (Intel Híbrido)"
                                                       FontWeight="Medium"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Visibility="{Binding IsNonHybridCpu, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource SubCardBorderStyle}"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="CPU atual não possui arquitetura híbrida P/E"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="Exibe Uso (%) e Clock (MHz) divididos entre Núcleos de Performance e Eficiência (12ª geração ou superior)"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     IsEnabled="{Binding IsIntelHybridCpu}"
                                                     IsChecked="{Binding SplitIntelHybridCores, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CPU Uso (%)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowCpuLoad, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CPU Clock (MHz)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowCpuClock, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CPU Temperatura (°C)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowCpuTemp, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CPU Consumo (Watts)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowCpuPower, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Grupo GPU -->
                            <TextBlock Text="PLACA DE VÍDEO (GPU)"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,14,0,8" />

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GPU Uso (%)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowGpuLoad, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GPU Clock (MHz)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowGpuClock, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GPU Temperatura (°C)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowGpuTemp, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GPU Consumo (Watts)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowGpuPower, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="GPU Uso de VRAM (GB / %)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Exibe a memória de vídeo em uso no bloco da GPU" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowGpuVram, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Grupo RAM -->
                            <TextBlock Text="MEMÓRIA RAM"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,14,0,8" />

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Uso de Memória RAM (GB e %)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Exibe a quantidade de RAM física ocupada em GB e porcentagem" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowRam, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <!-- Grupo FPS -->
                            <TextBlock Text="DESEMPENHO (FPS)"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="2,14,0,8" />

                            <Border Style="{StaticResource SettingsRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Contador de FPS (Quadros por Segundo)" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Captura oficial via eventos ETW do Windows (DXGI / D3D9 / DWM), 100% seguro contra Anti-Cheat" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowFps, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
