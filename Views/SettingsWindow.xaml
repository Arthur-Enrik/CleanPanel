<ui:FluentWindow x:Class="HardwareOverlayApp.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="CleanPanel"
                 Width="1160"
                 Height="760"
                 MinWidth="960"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource BgPrimary}"
                 Foreground="{DynamicResource TextPrimary}"
                 FontFamily="Segoe UI Variable Display, Segoe UI"
                 Typography.NumeralAlignment="Tabular">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Card Principal (Shadcn Surface) -->
        <Style x:Key="ShadcnCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Sub-Card Interno -->
        <Style x:Key="ShadcnSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Rótulo Muted de Cabeçalho -->
        <Style x:Key="ShadcnMutedLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Valor Numérico Tabular -->
        <Style x:Key="ShadcnTabularMetricStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- Item de Navegação da Barra Lateral (RadioButton) -->
        <Style x:Key="ShadcnNavItemStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MainNavigation" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveBar"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="2"
                                        Margin="0,0,10,0"
                                        Background="{DynamicResource AppAccentBrush}"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BgHover}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de Segmento (Ex: Dark / Light / Auto) -->
        <Style x:Key="ShadcnSegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário Padrão (Bordered) -->
        <Style x:Key="ShadcnOutlineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de Progresso Monocromática/Accent Limpa -->
        <Style x:Key="ShadcnProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track"
                                    CornerRadius="3"
                                    Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Swatch Circular de Cor -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra Superior Nativa Estendida -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPrimary}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <ui:TitleBar Title="CleanPanel"
                         Height="38"
                         ShowMaximize="True"
                         ShowMinimize="True">
                <ui:TitleBar.Header>
                    <Border Background="{DynamicResource BgHover}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="HARDWARE TELEMETRY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" />
                    </Border>
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <!-- Área Principal: Sidebar (220px) + Conteúdo (MaxWidth 960) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR ==================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPrimary}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo & Subtítulo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,18">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="6"
                                Background="{DynamicResource AppAccentBrush}"
                                Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Window24"
                                           FontSize="15"
                                           Foreground="{DynamicResource AppAccentForegroundBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CleanPanel"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Monitor &amp; HUD"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Menu de Navegação -->
                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource ShadcnNavItemStyle}"
                                     IsChecked="{Binding IsOverviewTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataHistogram24" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="Overview" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource ShadcnNavItemStyle}"
                                     IsChecked="{Binding IsCpuTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="CPU" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource ShadcnNavItemStyle}"
                                     IsChecked="{Binding IsGpuTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Video24" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="GPU" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource ShadcnNavItemStyle}"
                                     IsChecked="{Binding IsStorageTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="HardDrive20" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="Storage &amp; RAM" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource ShadcnNavItemStyle}"
                                     IsChecked="{Binding IsPersonalizationTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color24" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="Overlay &amp; Personalization" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource ShadcnNavItemStyle}"
                                     IsChecked="{Binding IsSettingsTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="Settings &amp; Hotkeys" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Rodapé da Sidebar: Status Overlay & Sair -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border Style="{StaticResource ShadcnCardStyle}" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="HUD Overlay"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center" />
                                    <ui:ToggleSwitch IsChecked="{Binding IsOverlayVisible, Mode=TwoWay}"
                                                     HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Grid.Row="1">
                                    <TextBlock Text="Captura ETW" Style="{StaticResource ShadcnMutedLabelStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FpsText}"
                                               DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource ShadcnTabularMetricStyle}"
                                               FontSize="12" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource ShadcnOutlineButtonStyle}"
                                Command="{Binding ExitApplicationCommand}"
                                Content="Encerrar CleanPanel"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ÁREA DE CONTEÚDO ==================== -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource BgPrimary}">
                <Grid MaxWidth="960" Margin="28,24,28,36">

                    <!-- ==================== TAB 0: OVERVIEW ==================== -->
                    <StackPanel Visibility="{Binding IsOverviewTabSelected, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Overview"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource ShadcnMutedLabelStyle}">
                                    <Run Text="{Binding OsName, Mode=OneWay}" />
                                    <Run Text=" • " />
                                    <Run Text="{Binding OsEdition, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding OsBuild, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </StackPanel>

                            <Border Style="{StaticResource ShadcnSubCardStyle}"
                                    Padding="12,8"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="OVERLAY ATIVO"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ui:ToggleSwitch IsChecked="{Binding IsOverlayVisible, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- KPI Summary Cards (4 Colunas) -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <!-- Card CPU -->
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="PROCESSADOR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding CpuLoadText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,2" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <TextBlock Text="{Binding CpuShortName}" Style="{StaticResource ShadcnMutedLabelStyle}" Margin="0,0,0,10" />
                                    <ProgressBar Value="{Binding CpuLoadBarValue, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock Text="{Binding CpuClockText}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding CpuTemperatureText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CpuTempBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card GPU -->
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="PLACA DE VÍDEO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding GpuLoadText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,2" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <TextBlock Text="{Binding GpuShortName}" Style="{StaticResource ShadcnMutedLabelStyle}" Margin="0,0,0,10" />
                                    <ProgressBar Value="{Binding SelectedGpu.CoreLoadBarValue, Mode=OneWay, FallbackValue=0}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock Text="{Binding GpuClockText}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding GpuTemperatureText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding GpuTempBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card RAM -->
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA RAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding RamPercentText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,2" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <TextBlock Text="{Binding RamTotalText}" Style="{StaticResource ShadcnMutedLabelStyle}" Margin="0,0,0,10" />
                                    <ProgressBar Value="{Binding RamUsageBarValue, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <TextBlock Text="{Binding RamUsedText}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding RamFreeText}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card FPS -->
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TAXA DE QUADROS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding FpsValueText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,2" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <TextBlock Text="ETW Ring-Buffer (FPS)" Style="{StaticResource ShadcnMutedLabelStyle}" Margin="0,0,0,10" />
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Padding="8,5" Margin="0,2,0,0">
                                        <DockPanel>
                                            <TextBlock Text="VRAM GPU" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding GpuVramText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Detalhes Rápidos de Sistema, GPUs e Discos -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card Processador & GPUs Detectadas -->
                            <Border Grid.Column="0" Style="{StaticResource ShadcnCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="HARDWARE DETECTADO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CpuName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CpuCoresThreadsSummary}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding GpuCountBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,8" />
                                    <ItemsControl ItemsSource="{Binding Gpus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding TotalVramDisplay}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <ProgressBar Value="{Binding CoreLoadBarValue, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,6" />
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding CoreTemperatureText}" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
                                                                <Run Text="Uso: " />
                                                                <Run Text="{Binding CoreLoadText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Card Armazenamento Overview -->
                            <Border Grid.Column="2" Style="{StaticResource ShadcnCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="UNIDADES DE ARMAZENAMENTO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding StorageDrives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding TemperatureText}" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding PhysicalDiskModel}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                                                        <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding OverviewLineText}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== TAB 1: CPU ==================== -->
                    <StackPanel Visibility="{Binding IsCpuTabSelected, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource ShadcnSubCardStyle}" Padding="10,6" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding CpuCoresThreadsSummary}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="CPU Telemetry" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding CpuName}" Margin="0,4,0,0" Style="{StaticResource ShadcnMutedLabelStyle}" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="USO TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding CpuLoadText}" FontSize="22" Margin="0,6,0,6" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <ProgressBar Value="{Binding CpuLoadBarValue, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="CLOCK MÉDIO / MÁX" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding CpuClockAvgMaxText}" FontSize="18" Margin="0,8,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="TEMPERATURA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding CpuTemperatureText}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" Foreground="{Binding CpuTempBrush}" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ENERGIA &amp; VCORE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding CpuPowerText}" FontSize="22" Margin="0,6,0,2" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <TextBlock Text="{Binding CpuVoltageText}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Suporte Intel Hybrid P/E-Cores -->
                        <Border Style="{StaticResource ShadcnCardStyle}"
                                Margin="0,0,0,16"
                                Visibility="{Binding IsIntelHybridCpu, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ARQUITETURA HÍBRIDA INTEL (P-CORES &amp; E-CORES)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,8,0" Padding="10,6">
                                            <TextBlock FontSize="12" Style="{StaticResource ShadcnTabularMetricStyle}">
                                                <Run Text="P-Cores: " Foreground="{DynamicResource TextMuted}" />
                                                <Run Text="{Binding CpuPCoreLoadText, Mode=OneWay}" />
                                                <Run Text=" (" Foreground="{DynamicResource TextMuted}" />
                                                <Run Text="{Binding CpuPCoreClockText, Mode=OneWay}" />
                                                <Run Text=")" Foreground="{DynamicResource TextMuted}" />
                                            </TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource ShadcnSubCardStyle}" Padding="10,6">
                                            <TextBlock FontSize="12" Style="{StaticResource ShadcnTabularMetricStyle}">
                                                <Run Text="E-Cores: " Foreground="{DynamicResource TextMuted}" />
                                                <Run Text="{Binding CpuECoreLoadText, Mode=OneWay}" />
                                                <Run Text=" (" Foreground="{DynamicResource TextMuted}" />
                                                <Run Text="{Binding CpuECoreClockText, Mode=OneWay}" />
                                                <Run Text=")" Foreground="{DynamicResource TextMuted}" />
                                            </TextBlock>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Separar no Overlay" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" HorizontalAlignment="Right" />
                                    <ui:ToggleSwitch IsChecked="{Binding SplitIntelHybridCores, Mode=TwoWay}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Grade de Núcleos / Threads -->
                        <Border Style="{StaticResource ShadcnCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Run Text="{Binding CpuPhysicalCores, Mode=OneWay}" />
                                        <Run Text=" Cores / " />
                                        <Run Text="{Binding CpuLogicalThreads, Mode=OneWay}" />
                                        <Run Text=" Threads" />
                                    </TextBlock>
                                    <TextBlock Text="UTILIZAÇÃO INDIVIDUAL POR NÚCLEO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CpuCores}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="4">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding LoadText}" DockPanel.Dock="Right" FontSize="12" Style="{StaticResource ShadcnTabularMetricStyle}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding CoreName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding LoadBarValue, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,6" />
                                                    <TextBlock Text="{Binding ClockText}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== TAB 2: GPU ==================== -->
                    <StackPanel Visibility="{Binding IsGpuTabSelected, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,20">
                            <ComboBox ItemsSource="{Binding Gpus}"
                                      SelectedItem="{Binding SelectedGpu, Mode=TwoWay}"
                                      DisplayMemberPath="DisplaySelectorTitle"
                                      MinWidth="280"
                                      DockPanel.Dock="Right"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="GPU Telemetry" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding GpuCountBadgeText}" Margin="0,4,0,0" Style="{StaticResource ShadcnMutedLabelStyle}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,0,16">
                            <DockPanel>
                                <Border Style="{StaticResource ShadcnSubCardStyle}" DockPanel.Dock="Right" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedGpu.TotalVramDisplay, FallbackValue=N/D}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedGpu.Vendor, FallbackValue=GPU}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.Name, FallbackValue=Adaptador Gráfico}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CARGA DO NÚCLEO (CORE)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.CoreLoadText, FallbackValue=0 %}" FontSize="24" Margin="0,6,0,8" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <ProgressBar Value="{Binding SelectedGpu.CoreLoadBarValue, Mode=OneWay, FallbackValue=0}" Style="{StaticResource ShadcnProgressBarStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA VRAM DEDICADA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.VramUsageText, FallbackValue=N/D}" FontSize="20" Margin="0,6,0,10" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                    <ProgressBar Value="{Binding SelectedGpu.VramUsagePercent, Mode=OneWay, FallbackValue=0}" Style="{StaticResource ShadcnProgressBarStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TEMPERATURA &amp; HOTSPOT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.CoreTemperatureText, FallbackValue=N/D}" FontSize="24" FontWeight="Bold" Margin="0,6,0,4" Foreground="{Binding GpuTempBrush}" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
                                        <Run Text="HotSpot: " />
                                        <Run Text="{Binding SelectedGpu.HotSpotTemperatureText, Mode=OneWay, FallbackValue=N/D}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="CORE CLOCK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.CoreClockText, FallbackValue=N/D}" FontSize="18" Margin="0,6,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="MEMORY CLOCK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.MemoryClockText, FallbackValue=N/D}" FontSize="18" Margin="0,6,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="CONSUMO (TBP)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.PowerText, FallbackValue=N/D}" FontSize="18" Margin="0,6,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ShadcnCardStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="VENTOINHAS (FAN)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedGpu.FanText, FallbackValue=N/D}" FontSize="18" Margin="0,6,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ==================== TAB 3: STORAGE & RAM ==================== -->
                    <StackPanel Visibility="{Binding IsStorageTabSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Storage &amp; Memory" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding RamDetailedSummaryText}" Margin="0,4,0,0" Style="{StaticResource ShadcnMutedLabelStyle}" />
                        </StackPanel>

                        <!-- Card RAM -->
                        <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding RamPercentText}" DockPanel.Dock="Right" FontSize="14" Style="{StaticResource ShadcnTabularMetricStyle}" Margin="10,0,0,0" />
                                    <TextBlock Text="MEMÓRIA FÍSICA (RAM)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ProgressBar Value="{Binding RamUsageBarValue, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,12" />
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL INSTALADA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding RamTotalText}" FontSize="16" Margin="0,4,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="EM USO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding RamUsedText}" FontSize="16" Margin="0,4,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DISPONÍVEL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding RamFreeText}" FontSize="16" Margin="0,4,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Partições Lógicas -->
                        <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PARTIÇÕES E VOLUMES LÓGICOS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding StorageDrives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding FileSystem}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding TemperatureText}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding PhysicalDiskModel}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
                                                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Style="{StaticResource ShadcnProgressBarStyle}" Margin="0,0,0,6" />
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding FreeSpaceSummaryText}" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding CapacitySummaryText}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Discos Físicos (Temperaturas SMART) -->
                        <Border Style="{StaticResource ShadcnCardStyle}">
                            <StackPanel>
                                <TextBlock Text="DISCOS FÍSICOS DETECTADOS (S.M.A.R.T.)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding TemperatureText}" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                                    <TextBlock Text="{Binding ModelName}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== TAB 4: OVERLAY & PERSONALIZATION ==================== -->
                    <StackPanel Visibility="{Binding IsPersonalizationTabSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Overlay &amp; Personalization" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Tema da interface, cor de destaque, transparência real e alertas térmicos do HUD." Margin="0,4,0,0" Style="{StaticResource ShadcnMutedLabelStyle}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <!-- Coluna Esquerda: Tema, Accent, Opacidade & Escala -->
                            <StackPanel Grid.Column="0">
                                <!-- Aparência & Accent -->
                                <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TEMA DA APLICAÇÃO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                        <Border Background="{DynamicResource BgHover}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,0,14">
                                            <UniformGrid Columns="3">
                                                <RadioButton GroupName="AppThemeSelector" Content="Dark" IsChecked="{Binding IsThemeDarkSelected, Mode=TwoWay}" Style="{StaticResource ShadcnSegmentRadioStyle}" />
                                                <RadioButton GroupName="AppThemeSelector" Content="Light" IsChecked="{Binding IsThemeLightSelected, Mode=TwoWay}" Style="{StaticResource ShadcnSegmentRadioStyle}" />
                                                <RadioButton GroupName="AppThemeSelector" Content="Auto" IsChecked="{Binding IsThemeAutoSelected, Mode=TwoWay}" Style="{StaticResource ShadcnSegmentRadioStyle}" />
                                            </UniformGrid>
                                        </Border>

                                        <DockPanel Margin="0,0,0,8">
                                            <Button Content="Resetar" DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding ResetAccentColorCommand}" Style="{StaticResource ShadcnOutlineButtonStyle}" Padding="8,4" />
                                            <TextBlock Text="COR DE DESTAQUE (ACCENT)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FAFAFA" ToolTip="Monochrome (#FAFAFA)" Command="{Binding SetAccentQuickColorCommand}" CommandParameter="#FAFAFA" />
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#00E5FF" ToolTip="Cyan (#00E5FF)" Command="{Binding SetAccentQuickColorCommand}" CommandParameter="#00E5FF" />
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#3B82F6" ToolTip="Blue (#3B82F6)" Command="{Binding SetAccentQuickColorCommand}" CommandParameter="#3B82F6" />
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#10B981" ToolTip="Emerald (#10B981)" Command="{Binding SetAccentQuickColorCommand}" CommandParameter="#10B981" />
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#8B5CF6" ToolTip="Violet (#8B5CF6)" Command="{Binding SetAccentQuickColorCommand}" CommandParameter="#8B5CF6" />
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#F59E0B" ToolTip="Amber (#F59E0B)" Command="{Binding SetAccentQuickColorCommand}" CommandParameter="#F59E0B" />
                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EF4444" ToolTip="Crimson (#EF4444)" Command="{Binding SetAccentQuickColorCommand}" CommandParameter="#EF4444" />
                                        </WrapPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Hex Custom:" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="8,5" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Transparência & Escala -->
                                <Border Style="{StaticResource ShadcnCardStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding OverlayOpacityPercentText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                            <TextBlock Text="OPACIDADE DO FUNDO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Slider Minimum="0.10"
                                                Maximum="1.00"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.05"
                                                LargeChange="0.10"
                                                Value="{Binding OverlayOpacity, Mode=TwoWay}"
                                                Margin="0,0,0,14" />

                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding OverlayScalePercentText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource ShadcnTabularMetricStyle}" />
                                                <Button Content="100%" Command="{Binding ResetOverlayScaleCommand}" Style="{StaticResource ShadcnOutlineButtonStyle}" Padding="8,3" />
                                            </StackPanel>
                                            <TextBlock Text="ESCALA DO OVERLAY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Slider Minimum="0.70"
                                                Maximum="2.00"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.05"
                                                LargeChange="0.10"
                                                Value="{Binding OverlayScale, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Coluna Direita: Pré-Visualização ao Vivo + Alertas Térmicos -->
                            <StackPanel Grid.Column="2">
                                <!-- Live Preview do Overlay (evidencia transparência real) -->
                                <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="PRÉ-VISUALIZAÇÃO DO HUD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                        <Border CornerRadius="8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="18" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1F2937" Offset="0.0" />
                                                    <GradientStop Color="#312E81" Offset="0.5" />
                                                    <GradientStop Color="#0F172A" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid HorizontalAlignment="Center" MinWidth="188">
                                                <!-- Preview Layer 0 -->
                                                <Border CornerRadius="10"
                                                        Background="{Binding OverlayBackgroundBrush}"
                                                        BorderBrush="{Binding OverlayBorderBrush}"
                                                        BorderThickness="1"
                                                        Opacity="{Binding NormalizedOverlayOpacity}" />
                                                <!-- Preview Layer 1 -->
                                                <Border Padding="14,10" Background="Transparent" Opacity="1.0">
                                                    <StackPanel>
                                                        <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Foreground="{Binding OverlayHeaderBrush}" Opacity="0.65" Margin="0,0,0,3" />
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock Text="Uso" FontSize="11" Foreground="#A1A1AA" />
                                                            <TextBlock Text="{Binding CpuLoadText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding OverlayValueTextBrush}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock Text="Temp" FontSize="11" Foreground="#A1A1AA" />
                                                            <TextBlock Text="{Binding CpuTemperatureText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding CpuTempBrush}" />
                                                        </DockPanel>

                                                        <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold" Foreground="{Binding OverlayHeaderBrush}" Opacity="0.65" Margin="0,8,0,3" />
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock Text="Uso" FontSize="11" Foreground="#A1A1AA" />
                                                            <TextBlock Text="{Binding GpuLoadText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding OverlayValueTextBrush}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock Text="Temp" FontSize="11" Foreground="#A1A1AA" />
                                                            <TextBlock Text="{Binding GpuTemperatureText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding GpuTempBrush}" />
                                                        </DockPanel>

                                                        <DockPanel Margin="0,8,0,0">
                                                            <TextBlock Text="FPS" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FpsText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding OverlayValueTextBrush}" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Alertas Térmicos -->
                                <Border Style="{StaticResource ShadcnCardStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="ALERTAS TÉRMICOS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                            <ui:ToggleSwitch IsChecked="{Binding EnableThermalColorAlerts, Mode=TwoWay}" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#FACC15" Margin="0,0,6,0" />
                                                <TextBlock Text="Alerta (Amarelo)" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Style="{StaticResource ShadcnTabularMetricStyle}">
                                                <Run Text="{Binding TempWarningThreshold, Mode=OneWay, StringFormat={}{0:0}}" />
                                                <Run Text=" °C" />
                                            </TextBlock>
                                        </DockPanel>
                                        <Slider Minimum="40" Maximum="105" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TempWarningThreshold, Mode=TwoWay}" Margin="0,0,0,10" />

                                        <DockPanel Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" />
                                                <TextBlock Text="Crítico (Vermelho)" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Style="{StaticResource ShadcnTabularMetricStyle}">
                                                <Run Text="{Binding TempCriticalThreshold, Mode=OneWay, StringFormat={}{0:0}}" />
                                                <Run Text=" °C" />
                                            </TextBlock>
                                        </DockPanel>
                                        <Slider Minimum="50" Maximum="115" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TempCriticalThreshold, Mode=TwoWay}" Margin="0,0,0,10" />

                                        <Button Content="Restaurar Padrão (70°C / 85°C)"
                                                Command="{Binding ResetThermalThresholdsCommand}"
                                                Style="{StaticResource ShadcnOutlineButtonStyle}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Paletas & Cores Personalizadas do Overlay -->
                        <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button Content="Restaurar Monocromático" DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding ResetOverlayColorsCommand}" Style="{StaticResource ShadcnOutlineButtonStyle}" Padding="10,5" />
                                    <TextBlock Text="PRESETS E CORES DO OVERLAY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </DockPanel>

                                <WrapPanel Margin="0,0,0,14">
                                    <Button Content="Monochrome" Command="{Binding ApplyColorPresetCommand}" CommandParameter="Monochrome" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,8,6" />
                                    <Button Content="Clean Cyan" Command="{Binding ApplyColorPresetCommand}" CommandParameter="CleanCyan" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,8,6" />
                                    <Button Content="Emerald Neon" Command="{Binding ApplyColorPresetCommand}" CommandParameter="EmeraldNeon" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,8,6" />
                                    <Button Content="Amber Gold" Command="{Binding ApplyColorPresetCommand}" CommandParameter="AmberGold" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,8,6" />
                                    <Button Content="Crimson Pulse" Command="{Binding ApplyColorPresetCommand}" CommandParameter="CrimsonPulse" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,8,6" />
                                    <Button Content="Purple Synth" Command="{Binding ApplyColorPresetCommand}" CommandParameter="PurpleSynth" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,8,6" />
                                    <Button Content="Minimal Light" Command="{Binding ApplyColorPresetCommand}" CommandParameter="MinimalLight" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,8,6" />
                                </WrapPanel>

                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Fundo (Hex)" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding OverlayBackgroundColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="6,4" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#09090B" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#09090B" />
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#141418" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#141418" />
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#000000" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#000000" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Borda (Hex)" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding OverlayBorderColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="6,4" Margin="0,0,0,6" />
                                            <Border Height="14" CornerRadius="3" Background="{Binding OverlayBorderBrush}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Cabeçalhos (Hex)" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding OverlayHeaderColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="6,4" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#FAFAFA" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#FAFAFA" />
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#00E5FF" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#00E5FF" />
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#A1A1AA" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#A1A1AA" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Valores (Hex)" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding OverlayValueTextColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="6,4" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#FAFAFA" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#FAFAFA" />
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#E4E4E7" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#E4E4E7" />
                                                <Button Width="18" Height="18" Style="{StaticResource ColorSwatchButtonStyle}" Background="#00E5FF" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#00E5FF" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Ordem das Seções no Overlay -->
                        <Border Style="{StaticResource ShadcnCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ORDEM DOS BLOCOS NO OVERLAY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding OverlaySections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,0,6" Padding="12,8">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                        <Button Content="↑" Width="30" Padding="4,2" Margin="0,0,6,0"
                                                                Style="{StaticResource ShadcnOutlineButtonStyle}"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                Command="{Binding Parent.MoveOverlaySectionUpCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="↓" Width="30" Padding="4,2"
                                                                Style="{StaticResource ShadcnOutlineButtonStyle}"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                Command="{Binding Parent.MoveOverlaySectionDownCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding PositionNumber}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== TAB 5: SETTINGS & HOTKEYS ==================== -->
                    <StackPanel Visibility="{Binding IsSettingsTabSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Settings &amp; Hotkeys" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Comportamento de exibição, sensores ativos no HUD, atalhos globais e alinhamento em tela." Margin="0,4,0,0" Style="{StaticResource ShadcnMutedLabelStyle}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Comportamento & Inicialização -->
                            <Border Grid.Column="0" Style="{StaticResource ShadcnCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="COMPORTAMENTO DO OVERLAY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12" />

                                    <DockPanel Margin="0,0,0,12">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SmartFullscreenOnly, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="Exibição Inteligente (Tela Cheia Real)" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="Oculta no desktop/navegadores; exibe apenas sobre jogos em tela cheia." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,12">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsCompactMode, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="Modo Compacto" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="Exibe barra horizontal enxuta com CPU %, GPU % e FPS." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,12">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsHorizontalLayout, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="Orientação Horizontal" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="Organiza todas as seções ativas lado a lado em linha única." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,12">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsOverlayLocked, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="Travar Overlay (Click-Through)" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="Impede arraste acidental e deixa cliques passarem direto para o jogo." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel>
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="Iniciar com o Windows" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="Inicia minimizado na bandeja com privilégios preservados." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Atalhos Globais & Posição -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource ShadcnCardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="ATALHOS GLOBAIS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
                                        <Border Style="{StaticResource ShadcnSubCardStyle}" Padding="10,6" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding HotkeyStatusMessage}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                        </Border>

                                        <TextBlock Text="Mostrar / Ocultar Overlay" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Tag="ToggleOverlay"
                                                     IsReadOnly="True"
                                                     Cursor="Hand"
                                                     Text="{Binding ToggleOverlayHotkeyDisplay, Mode=OneWay}"
                                                     GotFocus="HotkeyBox_GotFocus"
                                                     LostFocus="HotkeyBox_LostFocus"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Padrão" Command="{Binding ResetToggleOverlayHotkeyCommand}" Style="{StaticResource ShadcnOutlineButtonStyle}" />
                                        </Grid>

                                        <TextBlock Text="Alternar Modo Compacto" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Tag="ToggleCompact"
                                                     IsReadOnly="True"
                                                     Cursor="Hand"
                                                     Text="{Binding ToggleCompactModeHotkeyDisplay, Mode=OneWay}"
                                                     GotFocus="HotkeyBox_GotFocus"
                                                     LostFocus="HotkeyBox_LostFocus"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Padrão" Command="{Binding ResetToggleCompactModeHotkeyCommand}" Style="{StaticResource ShadcnOutlineButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ShadcnCardStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button Content="Resetar Posição" DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding ResetPositionCommand}" Style="{StaticResource ShadcnOutlineButtonStyle}" Padding="8,4" />
                                            <TextBlock Text="ALINHAMENTO EM TELA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <UniformGrid Columns="3">
                                            <Button Content="Sup. Esquerdo" Command="{Binding AlignOverlayCommand}" CommandParameter="TopLeft" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,6,6" />
                                            <Button Content="Sup. Centro" Command="{Binding AlignOverlayCommand}" CommandParameter="TopCenter" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="3,0,3,6" />
                                            <Button Content="Sup. Direito" Command="{Binding AlignOverlayCommand}" CommandParameter="TopRight" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="6,0,0,6" />
                                            <Button Content="Inf. Esquerdo" Command="{Binding AlignOverlayCommand}" CommandParameter="BottomLeft" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="0,0,6,0" />
                                            <Button Content="Inf. Centro" Command="{Binding AlignOverlayCommand}" CommandParameter="BottomCenter" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="3,0,3,0" />
                                            <Button Content="Inf. Direito" Command="{Binding AlignOverlayCommand}" CommandParameter="BottomRight" Style="{StaticResource ShadcnOutlineButtonStyle}" Margin="6,0,0,0" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Sensores Visíveis no Overlay -->
                        <Border Style="{StaticResource ShadcnCardStyle}">
                            <StackPanel>
                                <TextBlock Text="SENSORES EXIBIDOS NO OVERLAY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12" />
                                <UniformGrid Columns="3">
                                    <!-- Coluna CPU -->
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="CPU" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                            <CheckBox Content="Uso (%)" IsChecked="{Binding ShowCpuLoad, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Clock (MHz)" IsChecked="{Binding ShowCpuClock, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Temperatura (°C)" IsChecked="{Binding ShowCpuTemp, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Consumo (W)" IsChecked="{Binding ShowCpuPower, Mode=TwoWay}" Margin="0,0,0,8" />
                                            <CheckBox Content="Separar P-Cores / E-Cores"
                                                      IsChecked="{Binding SplitIntelHybridCores, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsIntelHybridCpu}" />
                                            <TextBlock Text="Disponível apenas em Intel híbridos (12ª gen+)."
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextWrapping="Wrap"
                                                       Margin="24,3,0,0"
                                                       Visibility="{Binding IsNonHybridCpu, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Coluna GPU -->
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="GPU" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                            <CheckBox Content="Uso (%)" IsChecked="{Binding ShowGpuLoad, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Clock (MHz)" IsChecked="{Binding ShowGpuClock, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Temperatura (°C)" IsChecked="{Binding ShowGpuTemp, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Consumo (W)" IsChecked="{Binding ShowGpuPower, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Memória VRAM" IsChecked="{Binding ShowGpuVram, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Coluna RAM & FPS -->
                                    <Border Style="{StaticResource ShadcnSubCardStyle}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="MEMÓRIA &amp; DESEMPENHO" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                            <CheckBox Content="Uso de Memória RAM" IsChecked="{Binding ShowRam, Mode=TwoWay}" Margin="0,0,0,6" />
                                            <CheckBox Content="Contador de FPS (ETW)" IsChecked="{Binding ShowFps, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
