<ui:FluentWindow x:Class="HardwareOverlayApp.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:HardwareOverlayApp.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="CleanPanel"
                 Width="1100"
                 Height="780"
                 MinWidth="880"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <!-- Estilo moderno de item do Menu Lateral compatível com Modo Claro e Modo Escuro -->
        <Style x:Key="SideNavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Barra indicadora lateral de seleção (Estilo Windows 11) -->
                                <Border x:Name="ActiveIndicator"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="1.5"
                                        Background="#00E5FF"
                                        Visibility="Hidden"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />

                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#1E00E5FF" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Card de Painel de Telemetria (Usa DynamicResource do WPF-UI para Temas Claro/Escuro) -->
        <Style x:Key="TelemetryCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Estilo de Sub-Card Interno / Caixa de Métrica (Adaptável ao Tema Claro/Escuro) -->
        <Style x:Key="SubCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Estilo de Botão Rápido de Amostra de Cor (Swatch) -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#00E5FF" />
                                <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título nativa Windows 11 com ícone oficial CleanPanel -->
        <ui:TitleBar Grid.Row="0"
                     Title="CleanPanel">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Estrutura Principal com Menu de Navegação Lateral + Área de Conteúdo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== MENU DE NAVEGAÇÃO LATERAL (SIDEBAR) ==================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,12,10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho de Status Rápido no Menu Lateral -->
                    <Border Grid.Row="0"
                            Style="{StaticResource SubCardBorderStyle}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="2,0,2,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TELEMETRIA ATIVA"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#00B8D4" />
                                <TextBlock Text="{Binding FpsText}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#F59E0B"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             ToolTip="Mostrar / Ocultar Overlay Flutuante"
                                             IsChecked="{Binding IsOverlayVisible, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Seções Principais de Monitoramento e Personalização -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="MONITORAMENTO"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="12,0,0,6" />

                        <!-- 1. Visão Geral -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsOverviewTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataHistogram24"
                                               FontSize="18"
                                               Foreground="#00B8D4"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Visão Geral"
                                           FontSize="13.5"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Processador (CPU) -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsCpuTabSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="DeveloperBoard24"
                                               FontSize="18"
                                               Foreground="#0288D1"
                                               VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Processador (CPU)"
                                           FontSize="13.5"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding CpuLoadText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#0288D1"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <!-- 3. Placa de Vídeo (GPU) -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsGpuTabSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Video24"
                                               FontSize="18"
                                               Foreground="#10B981"
                                               VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Placa de Vídeo (GPU)"
                                           FontSize="13.5"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding GpuLoadText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#10B981"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <!-- 4. Sistema & Armazenamento -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsStorageTabSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="HardDrive20"
                                               FontSize="18"
                                               Foreground="#A855F7"
                                               VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Sistema &amp; Discos"
                                           FontSize="13.5"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RamPercentText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A855F7"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="ESTILO &amp; LAYOUT"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="12,14,0,6" />

                        <!-- 5. Personalização (Temas, Cores & Ordem dos Sensores) -->
                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsPersonalizationTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color24"
                                               FontSize="18"
                                               Foreground="#14B8A6"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Personalização"
                                           FontSize="13.5"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Rodapé com Ícone de Engrenagem: 6. Configurações -->
                    <StackPanel Grid.Row="3">
                        <Border Height="1"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                Margin="6,0,6,8" />

                        <RadioButton Style="{StaticResource SideNavRadioButtonStyle}"
                                     GroupName="MainNavigation"
                                     IsChecked="{Binding IsSettingsTabSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24"
                                               FontSize="18"
                                               Foreground="#F59E0B"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Configurações"
                                           FontSize="13.5"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ÁREA DE CONTEÚDO PRINCIPAL ==================== -->
            <Grid Grid.Column="1">

                <!-- ======================================================================= -->
                <!-- 1. ABA "VISÃO GERAL" (RESUMO DO SISTEMA)                                -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsOverviewTabSelected, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18,24,24">
                    <StackPanel>
                        <TextBlock Text="Visão Geral do Sistema"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Resumo em tempo real das especificações e sensores de hardware do computador"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,18" />

                        <!-- CARD 1: SISTEMA OPERACIONAL -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="8"
                                        Background="#1A00E5FF"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0">
                                    <ui:SymbolIcon Symbol="Window24"
                                                   FontSize="22"
                                                   Foreground="#00B8D4"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SISTEMA OPERACIONAL"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#00B8D4" />
                                    <TextBlock Text="{Binding OsName}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,2,0,2" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Edição / Versão: "
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding OsEdition}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="   •   Build: "
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding OsBuild}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="#1F00E5FF"
                                        BorderBrush="#4400E5FF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FpsText}"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#F59E0B" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CARD 2: PROCESSADOR (CPU) -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="8"
                                            Background="#1A0288D1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                        <ui:SymbolIcon Symbol="DeveloperBoard24"
                                                       FontSize="22"
                                                       Foreground="#0288D1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="PROCESSADOR (CPU)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#0288D1" />
                                        <TextBlock Text="{Binding CpuName}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,2" />
                                        <TextBlock Text="{Binding CpuCoresThreadsSummary}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource SubCardBorderStyle}"
                                                Padding="12,6"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="USO"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding CpuLoadText}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#0288D1" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SubCardBorderStyle}"
                                                Padding="12,6">
                                            <StackPanel>
                                                <TextBlock Text="TEMP"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding CpuTemperatureText}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,12,0,0"
                                             Foreground="#0288D1"
                                             Value="{Binding CpuLoadBarValue, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: PLACA(S) DE VÍDEO (MULTI-GPU) -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="Video24"
                                                   FontSize="20"
                                                   Foreground="#10B981"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="PLACAS DE VÍDEO (GPU)"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#10B981"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2"
                                            Background="#1A10B981"
                                            CornerRadius="4"
                                            Padding="8,3">
                                        <TextBlock Text="{Binding GpuCountBadgeText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#10B981" />
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Gpus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="VRAM Total: "
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding TotalVramDisplay}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#10B981" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                                    Padding="10,5"
                                                                    Margin="0,0,8,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="USO"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding CoreLoadText}"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               Foreground="#10B981" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                                    Padding="10,5">
                                                                <StackPanel>
                                                                    <TextBlock Text="TEMP"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding CoreTemperatureText}"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <ProgressBar Minimum="0"
                                                                 Maximum="100"
                                                                 Height="5"
                                                                 Margin="0,10,0,0"
                                                                 Foreground="#10B981"
                                                                 Value="{Binding CoreLoadBarValue, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- CARD 4: MEMÓRIA RAM -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="8"
                                            Background="#1AA855F7"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                        <ui:SymbolIcon Symbol="Ram16"
                                                       FontSize="22"
                                                       Foreground="#A855F7"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MEMÓRIA RAM"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#A855F7" />
                                        <TextBlock Text="{Binding RamDetailedSummaryText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,2,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Instalada: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding RamTotalText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" />
                                            <TextBlock Text="Usada: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding RamUsedText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" />
                                            <TextBlock Text="Livre: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding RamFreeText}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource SubCardBorderStyle}"
                                            Padding="14,6"
                                            VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="OCUPAÇÃO"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding RamPercentText}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#A855F7" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,12,0,0"
                                             Foreground="#A855F7"
                                             Value="{Binding RamUsageBarValue, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- CARD 5: ARMAZENAMENTO (RESUMO DAS UNIDADES) -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="HardDrive20"
                                                   FontSize="20"
                                                   Foreground="#F59E0B"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                    <TextBlock Text="UNIDADES DE ARMAZENAMENTO"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#F59E0B"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding StorageDrives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="14,10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <TextBlock Text="{Binding PhysicalDiskModel}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Margin="0,1,0,2" />
                                                            <TextBlock Text="{Binding OverviewLineText}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource SubCardBorderStyle}"
                                                                Padding="10,4"
                                                                VerticalAlignment="Center">
                                                            <StackPanel>
                                                                <TextBlock Text="TEMP"
                                                                           FontSize="9.5"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding TemperatureText}"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Foreground="#F59E0B" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <ProgressBar Minimum="0"
                                                                 Maximum="100"
                                                                 Height="5"
                                                                 Margin="0,8,0,0"
                                                                 Foreground="#F59E0B"
                                                                 Value="{Binding UsagePercent, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 2. ABA "PROCESSADOR (CPU)" (DETALHES AVANÇADOS & POR NÚCLEO)           -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsCpuTabSelected, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18,24,24">
                    <StackPanel>
                        <TextBlock Text="Processador (CPU)"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Especificações físicas, sensores globais de energia/tensão e telemetria individual por núcleo"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,18" />

                        <!-- Especificações do Processador -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="MODELO DO PROCESSADOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#0288D1" />
                                    <TextBlock Text="{Binding CpuName}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,2" />
                                    <TextBlock Text="{Binding CpuCoresThreadsSummary}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Style="{StaticResource SubCardBorderStyle}"
                                        Padding="14,8"
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="NÚCLEOS FÍSICOS"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding CpuPhysicalCores}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#0288D1"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SubCardBorderStyle}"
                                        Padding="14,8"
                                        VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="THREADS LÓGICOS"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding CpuLogicalThreads}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#0288D1"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Métricas Globais da CPU (Uso %, Temp °C, Consumo W, Tensão VCore V, Clock Médio/Máx MHz) -->
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <!-- Uso Total (%) -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="USO TOTAL DA CPU"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding CpuLoadText}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#0288D1"
                                               Margin="0,4,0,8" />
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Height="6"
                                                 Foreground="#0288D1"
                                                 Value="{Binding CpuLoadBarValue, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Temperatura (°C) -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="3,0,3,12">
                                <StackPanel>
                                    <TextBlock Text="TEMPERATURA (PACKAGE / TDIE)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding CpuTemperatureText}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Sensor térmico principal"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Consumo (Watts) -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CONSUMO ELÉTRICO (PACKAGE)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding CpuPowerText}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#F59E0B"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Potência em tempo real"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <!-- Tensão VCore (V) -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="TENSÃO DO NÚCLEO (VCORE / VID)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding CpuVoltageText}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#00B8D4"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Leitura direta CPU / SuperIO Placa-Mãe"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Clock Médio / Máximo (MHz) -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="FREQUÊNCIA (CLOCK MÉDIO / MÁXIMO)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding CpuClockAvgMaxText}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="Frequência operacional dos núcleos ativos"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Grade de Núcleos (Per-Core Telemetry) -->
                        <TextBlock Text="Telemetria Individual por Núcleo / Thread"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,4,0,10" />

                        <ItemsControl ItemsSource="{Binding CpuCores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CoreName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ClockText}"
                                                           FontFamily="Consolas"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding LoadText}"
                                                           FontFamily="Consolas"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="#0288D1"
                                                           Width="44"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Height="5"
                                                         Margin="0,7,0,0"
                                                         Foreground="#0288D1"
                                                         Value="{Binding LoadBarValue, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 3. ABA "PLACA DE VÍDEO (GPU)" (MULTI-GPU E SENSORES AVANÇADOS)         -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsGpuTabSelected, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18,24,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Placa de Vídeo (GPU)"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Suporte Multi-GPU (Integrada e Dedicada) com telemetria de Core, Hot Spot, Clocks, VRAM, Energia e Fans"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#1A10B981"
                                    BorderBrush="#4410B981"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuCountBadgeText}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#10B981" />
                            </Border>
                        </Grid>

                        <!-- Seletor de GPU no Topo (ComboBox Multi-GPU) -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,20,0">
                                    <TextBlock Text="SELECIONAR ADAPTADOR GRÁFICO (GPU)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#10B981" />
                                    <TextBlock Text="Alterne entre a GPU dedicada e a integrada"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Gpus}"
                                          SelectedItem="{Binding SelectedGpu, Mode=TwoWay}"
                                          DisplayMemberPath="DisplaySelectorTitle"
                                          VerticalAlignment="Center"
                                          FontSize="13.5"
                                          FontWeight="SemiBold" />
                            </Grid>
                        </Border>

                        <!-- Painel de Métricas em Tempo Real da GPU Selecionada -->
                        <StackPanel DataContext="{Binding SelectedGpu}">
                            <!-- Cabeçalho do Modelo da GPU -->
                            <Border Style="{StaticResource TelemetryCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Vendor}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#10B981" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource SubCardBorderStyle}"
                                            Padding="14,8"
                                            VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="VRAM TOTAL"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding TotalVramDisplay}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Linha 1: Uso do Core (%) e Uso de VRAM (GB) -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                    <StackPanel>
                                        <TextBlock Text="USO DO CORE (GPU LOAD)"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding CoreLoadText}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#10B981"
                                                   Margin="0,4,0,8" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="6"
                                                     Foreground="#10B981"
                                                     Value="{Binding CoreLoadBarValue, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="USO DE MEMÓRIA DE VÍDEO (VRAM USADA / TOTAL)"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding VramUsageText}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,8,0,10" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="6"
                                                     Foreground="#00B8D4"
                                                     Value="{Binding VramUsagePercent, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Linha 2: Temperatura Core, Temperatura Hot Spot, Clock Core, Clock Memória -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TEMPERATURA CORE"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CoreTemperatureText}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TEMPERATURA HOT SPOT"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding HotSpotTemperatureText}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="#F59E0B"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CLOCK DO CORE"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CoreClockText}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#10B981"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CLOCK DA MEMÓRIA"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding MemoryClockText}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- Linha 3: Consumo Elétrico (W) e Velocidade dos Fans (RPM / %) -->
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="0,0,6,12">
                                    <StackPanel>
                                        <TextBlock Text="CONSUMO DA GPU (BOARD / PACKAGE POWER)"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding PowerText}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#F59E0B"
                                                   Margin="0,4,0,2" />
                                        <TextBlock Text="Exibe N/D caso o hardware não possua sensor de potência"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource TelemetryCardBorderStyle}" Margin="6,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="VELOCIDADE DOS FANS (VENTOINHAS)"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding FanText}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#00B8D4"
                                                   Margin="0,4,0,2" />
                                        <TextBlock Text="Rotação em RPM / % (ou N/D em GPUs integradas / Fan Stop)"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 4. ABA "SISTEMA & ARMAZENAMENTO" (RAM DETALHADA + PARTIÇÕES + DISCOS)  -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsStorageTabSelected, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18,24,24">
                    <StackPanel>
                        <TextBlock Text="Sistema &amp; Armazenamento"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Ocupação detalhada da Memória RAM física, espaço das partições do Windows e temperatura dos SSDs/HDDs"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,18" />

                        <!-- Uso Detalhado de Memória RAM -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MEMÓRIA RAM FÍSICA"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#A855F7" />
                                        <TextBlock Text="{Binding RamDetailedSummaryText}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RamPercentText}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#A855F7"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="10"
                                             Margin="0,12,0,14"
                                             Foreground="#A855F7"
                                             Value="{Binding RamUsageBarValue, Mode=OneWay}" />

                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource SubCardBorderStyle}" Padding="12,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL INSTALADO" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding RamTotalText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubCardBorderStyle}" Padding="12,8" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="MEMÓRIA EM USO" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding RamUsedText}" FontSize="16" FontWeight="Bold" Foreground="#A855F7" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SubCardBorderStyle}" Padding="12,8" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="MEMÓRIA LIVRE" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding RamFreeText}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Lista de Unidades de Armazenamento (Espaço Ocupado vs. Total + Temperatura Física SSD/HDD) -->
                        <TextBlock Text="Unidades de Armazenamento (Partições e Temperatura Física)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,6,0,10" />

                        <ItemsControl ItemsSource="{Binding StorageDrives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TelemetryCardBorderStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="44"
                                                        Height="44"
                                                        CornerRadius="8"
                                                        Background="#1AF59E0B"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,14,0">
                                                    <ui:SymbolIcon Symbol="HardDrive20"
                                                                   FontSize="22"
                                                                   Foreground="#F59E0B"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="16"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Border Style="{StaticResource SubCardBorderStyle}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileSystem}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#00B8D4" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PhysicalDiskModel}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Temperatura Física do SSD/HDD (com fallback para "Sem sensor") -->
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource SubCardBorderStyle}"
                                                        Padding="14,6"
                                                        VerticalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="TEMPERATURA FÍSICA"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding TemperatureText}"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"
                                                                   Foreground="#F59E0B"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Height="8"
                                                         Margin="0,12,0,8"
                                                         Foreground="#F59E0B"
                                                         Value="{Binding UsagePercent, Mode=OneWay}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CapacitySummaryText}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FreeSpaceSummaryText}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sensores Físicos de Discos (HardwareType.Storage - LibreHardwareMonitor) -->
                        <TextBlock Text="Discos Físicos Detectados (Sensores SMART / LibreHardwareMonitor)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,10" />

                        <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TelemetryCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Grid.Column="0"
                                                           Symbol="HardDrive20"
                                                           FontSize="20"
                                                           Foreground="#00B8D4"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ModelName}"
                                                           FontSize="14.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Unidade Física (SMART / Sensor Térmico)"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="12,5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TemperatureText}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#00B8D4" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 5. ABA "PERSONALIZAÇÃO" (TEMAS DO APP, CORES E ORDEM DO OVERLAY)       -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsPersonalizationTabSelected, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18,24,24">
                    <StackPanel>
                        <TextBlock Text="Personalização Visual &amp; Layout do Overlay"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Customize o tema do CleanPanel, a paleta de cores em tempo real e a ordem de exibição dos blocos no Overlay"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,18" />

                        <!-- ==================== A. TEMA DO APLICATIVO ==================== -->
                        <TextBlock Text="Tema do Aplicativo (CleanPanel)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Modo de Aparência da Janela Principal"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Escolha entre o tema Escuro, Claro ou sincronizado automaticamente com o tema atual do Windows 11"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,12" />

                                <UniformGrid Columns="3">
                                    <!-- Opção 1: Escuro (Dark) -->
                                    <Border Style="{StaticResource SubCardBorderStyle}"
                                            Padding="12,10"
                                            Margin="0,0,6,0">
                                        <RadioButton GroupName="AppThemeGroup"
                                                     IsChecked="{Binding IsThemeDarkSelected, Mode=TwoWay}"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     Cursor="Hand">
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock Text="Escuro (Dark)"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Visual escuro de alto contraste"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Border>

                                    <!-- Opção 2: Claro (Light) -->
                                    <Border Style="{StaticResource SubCardBorderStyle}"
                                            Padding="12,10"
                                            Margin="3,0,3,0">
                                        <RadioButton GroupName="AppThemeGroup"
                                                     IsChecked="{Binding IsThemeLightSelected, Mode=TwoWay}"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     Cursor="Hand">
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock Text="Claro (Light)"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Superfícies claras e nítidas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Border>

                                    <!-- Opção 3: Automático (Seguir o Windows) -->
                                    <Border Style="{StaticResource SubCardBorderStyle}"
                                            Padding="12,10"
                                            Margin="6,0,0,0">
                                        <RadioButton GroupName="AppThemeGroup"
                                                     IsChecked="{Binding IsThemeAutoSelected, Mode=TwoWay}"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     Cursor="Hand">
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock Text="Automático (Windows)"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Segue o tema do sistema"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- ==================== B. PERSONALIZAÇÃO DE CORES DO OVERLAY ==================== -->
                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Personalização de Cores do Overlay"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1"
                                       Content="Restaurar Cores Padrão"
                                       Appearance="Secondary"
                                       Command="{Binding ResetOverlayColorsCommand}" />
                        </Grid>

                        <!-- Paletas Rápidas Predefinidas -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Temas Rápidos de Cores para o Overlay"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Aplique instantaneamente uma combinação harmônica de fundo, borda, títulos e métricas:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,10" />

                                <UniformGrid Columns="3" Rows="2">
                                    <ui:Button Content="Ciano Clean (Padrão)"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,6,6"
                                               Command="{Binding ApplyColorPresetCommand}"
                                               CommandParameter="CleanCyan" />
                                    <ui:Button Content="Verde Esmeralda"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="3,0,3,6"
                                               Command="{Binding ApplyColorPresetCommand}"
                                               CommandParameter="EmeraldNeon" />
                                    <ui:Button Content="Âmbar Dourado"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="6,0,0,6"
                                               Command="{Binding ApplyColorPresetCommand}"
                                               CommandParameter="AmberGold" />
                                    <ui:Button Content="Rubi Carmesim"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,6,0"
                                               Command="{Binding ApplyColorPresetCommand}"
                                               CommandParameter="CrimsonPulse" />
                                    <ui:Button Content="Roxo Synthwave"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="3,0,3,0"
                                               Command="{Binding ApplyColorPresetCommand}"
                                               CommandParameter="PurpleSynth" />
                                    <ui:Button Content="Claro Minimalista"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="6,0,0,0"
                                               Command="{Binding ApplyColorPresetCommand}"
                                               CommandParameter="MinimalLight" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 1. Cor do Fundo do Overlay -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="125" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="{Binding OverlayBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="1. Cor do Fundo do Overlay"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Cor base da janela flutuante (Padrão: #141418)"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,14,0">
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#141418" ToolTip="#141418" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#141418" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#0F172A" ToolTip="#0F172A" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#0F172A" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#090D16" ToolTip="#090D16" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#090D16" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#18181B" ToolTip="#18181B" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#18181B" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#1E1B4B" ToolTip="#1E1B4B" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#1E1B4B" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#F8FAFC" ToolTip="#F8FAFC" Command="{Binding SetBackgroundQuickColorCommand}" CommandParameter="#F8FAFC" />
                                </StackPanel>

                                <TextBox Grid.Column="3"
                                         Text="{Binding OverlayBackgroundColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"
                                         ToolTip="Código Hex (#RRGGBB ou #AARRGGBB)" />
                            </Grid>
                        </Border>

                        <!-- 2. Cor da Borda do Overlay -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="125" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="{Binding OverlayBorderBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="2. Cor da Borda do Overlay"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Contorno sutil do painel flutuante (Padrão: #33FFFFFF)"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <TextBox Grid.Column="2"
                                         Text="{Binding OverlayBorderColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"
                                         ToolTip="Código Hex (#RRGGBB ou #AARRGGBB)" />
                            </Grid>
                        </Border>

                        <!-- 3. Cor de Destaque dos Títulos / Cabeçalhos de Hardware -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="125" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="{Binding OverlayHeaderBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="3. Cor de Destaque dos Títulos de Hardware"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Cor dos nomes reais de CPU, GPU e Memória RAM (Padrão: #00E5FF)"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,14,0">
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#00E5FF" ToolTip="#00E5FF" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#00E5FF" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#38BDF8" ToolTip="#38BDF8" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#38BDF8" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#2DD4BF" ToolTip="#2DD4BF" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#2DD4BF" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#10B981" ToolTip="#10B981" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#10B981" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFB900" ToolTip="#FFB900" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#FFB900" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#F43F5E" ToolTip="#F43F5E" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#F43F5E" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#A855F7" ToolTip="#A855F7" Command="{Binding SetHeaderQuickColorCommand}" CommandParameter="#A855F7" />
                                </StackPanel>

                                <TextBox Grid.Column="3"
                                         Text="{Binding OverlayHeaderColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"
                                         ToolTip="Código Hex (#RRGGBB ou #AARRGGBB)" />
                            </Grid>
                        </Border>

                        <!-- 4. Cor do Texto / Valores das Métricas -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="125" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="{Binding OverlayValueTextBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="4. Cor do Texto / Valores das Métricas"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Cor das leituras numéricas de Uso, Temperatura, Clock e VRAM (Padrão: #FFFFFF)"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,14,0">
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFFFFF" ToolTip="#FFFFFF" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#FFFFFF" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#E2E8F0" ToolTip="#E2E8F0" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#E2E8F0" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#38BDF8" ToolTip="#38BDF8" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#38BDF8" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#6CCB5F" ToolTip="#6CCB5F" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#6CCB5F" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFB900" ToolTip="#FFB900" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#FFB900" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#0F172A" ToolTip="#0F172A" Command="{Binding SetValueQuickColorCommand}" CommandParameter="#0F172A" />
                                </StackPanel>

                                <TextBox Grid.Column="3"
                                         Text="{Binding OverlayValueTextColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"
                                         ToolTip="Código Hex (#RRGGBB ou #AARRGGBB)" />
                            </Grid>
                        </Border>

                        <!-- ==================== C. ORDENAÇÃO DOS BLOCOS NO OVERLAY ==================== -->
                        <TextBlock Text="Ordenação Dinâmica dos Blocos no Overlay"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,10" />

                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Ordem de Exibição dos Grupos de Sensores"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Use os botões Subir (▲) e Descer (▼) para reorganizar a posição de FPS, CPU, GPU e RAM no Overlay em tempo real:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,12" />

                                <ItemsControl ItemsSource="{Binding OverlaySections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubCardBorderStyle}"
                                                    Padding="14,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Posição Numérica (1º, 2º, 3º, 4º) -->
                                                    <Border Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="6"
                                                            Background="#1F00E5FF"
                                                            BorderBrush="#4400E5FF"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding PositionNumber, StringFormat={}{0}º}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="#00B8D4"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Key, StringFormat=Identificador do Bloco: {0}}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <ui:Button Content="Subir (▲)"
                                                                   Appearance="Secondary"
                                                                   Margin="0,0,6,0"
                                                                   IsEnabled="{Binding CanMoveUp}"
                                                                   Command="{Binding Parent.MoveOverlaySectionUpCommand}"
                                                                   CommandParameter="{Binding}" />
                                                        <ui:Button Content="Descer (▼)"
                                                                   Appearance="Secondary"
                                                                   IsEnabled="{Binding CanMoveDown}"
                                                                   Command="{Binding Parent.MoveOverlaySectionDownCommand}"
                                                                   CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================================= -->
                <!-- 6. RODAPÉ (ÍCONE DE ENGRENAGEM): "CONFIGURAÇÕES" DO APP E DO OVERLAY   -->
                <!-- ======================================================================= -->
                <ScrollViewer Visibility="{Binding IsSettingsTabSelected, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,18,24,24">
                    <StackPanel>
                        <TextBlock Text="Configurações do Aplicativo e Overlay"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Personalize o comportamento do Overlay flutuante em jogos, atalhos globais e inicialização com o Windows"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,18" />

                        <!-- ==================== CONTROLE GERAL ==================== -->
                        <TextBlock Text="Controle Geral"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <!-- Mostrar / Ocultar Overlay -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Mostrar / Ocultar Overlay"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Alterna a visibilidade do overlay flutuante na tela"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsOverlayVisible, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- Exibição Inteligente: Apenas em Tela Cheia -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Exibição Inteligente: Apenas em Tela Cheia"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Oculta automaticamente na área de trabalho e exibe apenas quando um jogo em tela cheia estiver em foco"
                                               FontSize="12"
                                               Opacity="0.7"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding SmartFullscreenOnly, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- Modo Compacto (Destacado) -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Modo Compacto (Apenas FPS, CPU % e GPU %)"
                                               FontWeight="SemiBold"
                                               Foreground="#00B8D4"
                                               FontSize="14" />
                                    <TextBlock Text="Exibe exclusivamente FPS, uso de CPU e uso de GPU com espaçamento reduzido"
                                               FontSize="12"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsCompactMode, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- Aviso visual do Atalho Global Ctrl + Shift + O -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Atalho Global em Jogos"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Use o atalho a qualquer momento dentro do jogo para mostrar ou ocultar o overlay"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <Border Background="#2600E5FF"
                                    BorderBrush="#6600E5FF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4">
                                <TextBlock Text="Ctrl + Shift + O"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           Foreground="#00B8D4"
                                           FontSize="13" />
                            </Border>
                        </ui:CardControl>

                        <!-- Travar Overlay (Click-Through) -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Travar Overlay (Modo Click-Through)"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Faz os cliques do mouse atravessarem o overlay direto para o jogo"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsOverlayLocked, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- Iniciar com o Windows -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Iniciar com o Windows (Administrador)"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Inicia minimizado na bandeja do sistema ao fazer logon via Agendador de Tarefas"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- Slider de Opacidade (0.1 a 1.0) -->
                        <ui:CardControl Margin="0,0,0,16">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Opacidade do Fundo do Overlay"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Ajusta a transparência do card do Overlay (10% a 100%)"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Slider Minimum="0.1"
                                        Maximum="1.0"
                                        SmallChange="0.05"
                                        LargeChange="0.1"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="False"
                                        Width="140"
                                        VerticalAlignment="Center"
                                        Value="{Binding OverlayOpacity, Mode=TwoWay}" />
                                <TextBlock Text="{Binding OverlayOpacityPercentText}"
                                           Width="46"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- ==================== LAYOUT E ALINHAMENTO NA TELA ==================== -->
                        <TextBlock Text="Orientação e Alinhamento na Tela"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,10" />

                        <!-- Orientação Horizontal vs Vertical -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Orientação Horizontal (Barra em Linha)"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Organiza os blocos de hardware lado a lado em linha com separadores discretos"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsHorizontalLayout, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- Grade de Botões de Alinhamento Rápido (6 Posições) -->
                        <Border Style="{StaticResource TelemetryCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Predefinições Rápidas de Alinhamento"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Posicione o Overlay instantaneamente em qualquer canto ou centro da tela:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,10" />

                                <UniformGrid Columns="3"
                                             Rows="2">
                                    <ui:Button Content="Superior Esquerdo"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,6,6"
                                               Command="{Binding AlignOverlayCommand}"
                                               CommandParameter="TopLeft" />
                                    <ui:Button Content="Superior Centro"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="3,0,3,6"
                                               Command="{Binding AlignOverlayCommand}"
                                               CommandParameter="TopCenter" />
                                    <ui:Button Content="Superior Direito"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="6,0,0,6"
                                               Command="{Binding AlignOverlayCommand}"
                                               CommandParameter="TopRight" />
                                    <ui:Button Content="Inferior Esquerdo"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,6,0"
                                               Command="{Binding AlignOverlayCommand}"
                                               CommandParameter="BottomLeft" />
                                    <ui:Button Content="Inferior Centro"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="3,0,3,0"
                                               Command="{Binding AlignOverlayCommand}"
                                               CommandParameter="BottomCenter" />
                                    <ui:Button Content="Inferior Direito"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="6,0,0,0"
                                               Command="{Binding AlignOverlayCommand}"
                                               CommandParameter="BottomRight" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Ações Rápidas: Resetar Posição e Encerrar Aplicativo -->
                        <ui:CardControl Margin="0,0,0,16">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Ações do Aplicativo"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Fechar no 'X' minimiza para a bandeja. Use 'Encerrar Aplicativo' para sair."
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Resetar Posição (50, 50)"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           Command="{Binding ResetPositionCommand}" />
                                <ui:Button Content="Encerrar Aplicativo"
                                           Appearance="Danger"
                                           Command="{Binding ExitApplicationCommand}" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- ==================== SENSORES DO OVERLAY FLUTUANTE ==================== -->
                        <TextBlock Text="Sensores Exibidos no Overlay — Desempenho (ETW)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,10" />

                        <ui:CardControl Margin="0,0,0,16">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Exibir FPS (Quadros por Segundo)"
                                               FontWeight="Medium"
                                               FontSize="14" />
                                    <TextBlock Text="Captura oficial via eventos DXGI/D3D9 do Windows (seguro contra Anti-Cheat)"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowFps, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- ==================== MÉTRICAS DE CPU NO OVERLAY ==================== -->
                        <TextBlock Text="Métricas de CPU no Overlay"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,10" />

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <TextBlock Text="CPU Temperatura (°C)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowCpuTemp, Mode=TwoWay}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <TextBlock Text="CPU Uso Total (%)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowCpuLoad, Mode=TwoWay}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <TextBlock Text="CPU Clock (MHz)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowCpuClock, Mode=TwoWay}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,16">
                            <ui:CardControl.Header>
                                <TextBlock Text="CPU Consumo (Watts)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowCpuPower, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- ==================== MÉTRICAS DE GPU NO OVERLAY ==================== -->
                        <TextBlock Text="Métricas de GPU no Overlay (NVIDIA / AMD / Intel)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,10" />

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <TextBlock Text="GPU Temperatura (°C)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowGpuTemp, Mode=TwoWay}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <TextBlock Text="GPU Uso (%)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowGpuLoad, Mode=TwoWay}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <TextBlock Text="GPU Clock (MHz)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowGpuClock, Mode=TwoWay}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <TextBlock Text="GPU Consumo (Watts)"
                                           FontWeight="Medium"
                                           FontSize="14" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowGpuPower, Mode=TwoWay}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,16">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="GPU Uso de VRAM (GB / %)"
                                               FontWeight="Medium"
                                               FontSize="14" />
                                    <TextBlock Text="Exibe a memória de vídeo em uso no bloco da GPU (ex: 6.2 / 8.0 GB (78%))"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowGpuVram, Mode=TwoWay}" />
                        </ui:CardControl>

                        <!-- ==================== MÉTRICAS DE RAM NO OVERLAY ==================== -->
                        <TextBlock Text="Memória RAM no Overlay"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,10" />

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Uso de Memória RAM (GB e %)"
                                               FontWeight="Medium"
                                               FontSize="14" />
                                    <TextBlock Text="Exibe a quantidade de RAM física em uso e a porcentagem ocupada"
                                               FontSize="12"
                                               Opacity="0.7" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowRam, Mode=TwoWay}" />
                        </ui:CardControl>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
