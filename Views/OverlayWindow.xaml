<Window x:Class="HardwareOverlayApp.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HardwareOverlayApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Hardware Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Consolas"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVis}}"
          Margin="4">
        <!-- Card escuro arredondado com opacidade controlada pelo Slider (0.1 a 1.0) -->
        <Border CornerRadius="8"
                Background="#141418"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Opacity="{Binding OverlayOpacity}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.45"
                                  Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- Métricas com fonte monoespaçada e valores alinhados à direita -->
        <StackPanel Margin="14,10"
                    MinWidth="225">

            <!-- ==================== SEÇÃO FPS ==================== -->
            <Grid Visibility="{Binding ShowFps, Converter={StaticResource BoolToVis}}"
                  Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="FPS"
                           Foreground="#FFB900"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding FpsText}"
                           Foreground="#FFB900"
                           FontWeight="Bold"
                           FontSize="14"
                           TextAlignment="Right"
                           MinWidth="95" />
            </Grid>

            <!-- ==================== SEÇÃO CPU ==================== -->
            <StackPanel Visibility="{Binding ShowCpuSection, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,6">
                <TextBlock Text="CPU"
                           Foreground="#60CDFF"
                           FontWeight="Bold"
                           FontSize="11"
                           Margin="0,0,0,3" />

                <!-- CPU Temperatura -->
                <Grid Visibility="{Binding ShowCpuTemp, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Temp"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuTemperatureText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>

                <!-- CPU Uso -->
                <Grid Visibility="{Binding ShowCpuLoad, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Uso"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuLoadText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>

                <!-- CPU Clock -->
                <Grid Visibility="{Binding ShowCpuClock, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Clock"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuClockText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>

                <!-- CPU Power -->
                <Grid Visibility="{Binding ShowCpuPower, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Power"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuPowerText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>
            </StackPanel>

            <!-- ==================== SEÇÃO GPU ==================== -->
            <StackPanel Visibility="{Binding ShowGpuSection, Converter={StaticResource BoolToVis}}"
                        Margin="0,2,0,6">
                <TextBlock Text="GPU"
                           Foreground="#6CCB5F"
                           FontWeight="Bold"
                           FontSize="11"
                           Margin="0,0,0,3" />

                <!-- GPU Temperatura -->
                <Grid Visibility="{Binding ShowGpuTemp, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Temp"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuTemperatureText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>

                <!-- GPU Uso -->
                <Grid Visibility="{Binding ShowGpuLoad, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Uso"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuLoadText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>

                <!-- GPU Clock -->
                <Grid Visibility="{Binding ShowGpuClock, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Clock"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuClockText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>

                <!-- GPU Power -->
                <Grid Visibility="{Binding ShowGpuPower, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Power"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuPowerText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="95" />
                </Grid>
            </StackPanel>

            <!-- ==================== SEÇÃO RAM ==================== -->
            <StackPanel Visibility="{Binding ShowRam, Converter={StaticResource BoolToVis}}"
                        Margin="0,2,0,0">
                <TextBlock Text="MEMÓRIA"
                           Foreground="#C586C0"
                           FontWeight="Bold"
                           FontSize="11"
                           Margin="0,0,0,3" />

                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="RAM"
                               Foreground="#C586C0"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RamUsageText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               MinWidth="120" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
