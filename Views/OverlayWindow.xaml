<Window x:Class="HardwareOverlayApp.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HardwareOverlayApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Hardware Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Consolas"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Visibility="{Binding EffectiveOverlayVisible, Converter={StaticResource BoolToVis}}"
          Margin="4">
        <!-- Card escuro arredondado com opacidade controlada pelo Slider (0.1 a 1.0) -->
        <Border CornerRadius="8"
                Background="#141418"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Opacity="{Binding OverlayOpacity}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.45"
                                  Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- ==================== LAYOUT VERTICAL (COLUNA) ==================== -->
        <StackPanel Visibility="{Binding IsVerticalLayout, Converter={StaticResource BoolToVis}}"
                    Margin="{Binding OverlayCardPadding}"
                    MinWidth="175">

            <!-- FPS -->
            <Grid Visibility="{Binding EffectiveShowFps, Converter={StaticResource BoolToVis}}"
                  Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="FPS"
                           Foreground="#FFB900"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding FpsText}"
                           Foreground="#FFB900"
                           FontWeight="Bold"
                           FontSize="13"
                           TextAlignment="Right"
                           Margin="12,0,0,0" />
            </Grid>

            <!-- SEÇÃO CPU -->
            <StackPanel Visibility="{Binding ShowCpuSection, Converter={StaticResource BoolToVis}}"
                        Margin="0,2,0,2">
                <TextBlock Text="CPU"
                           Visibility="{Binding ShowSectionHeaders, Converter={StaticResource BoolToVis}}"
                           Foreground="#60CDFF"
                           FontWeight="Bold"
                           FontSize="11"
                           Margin="0,2,0,2" />

                <!-- CPU Temperatura -->
                <Grid Visibility="{Binding EffectiveShowCpuTemp, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Temp"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuTemperatureText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- CPU Uso -->
                <Grid Visibility="{Binding EffectiveShowCpuLoad, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Uso"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuLoadText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- CPU Clock -->
                <Grid Visibility="{Binding EffectiveShowCpuClock, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Clock"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuClockText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- CPU Power -->
                <Grid Visibility="{Binding EffectiveShowCpuPower, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="CPU Power"
                               Foreground="#60CDFF"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuPowerText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>
            </StackPanel>

            <!-- SEÇÃO GPU -->
            <StackPanel Visibility="{Binding ShowGpuSection, Converter={StaticResource BoolToVis}}"
                        Margin="0,2,0,2">
                <TextBlock Text="GPU"
                           Visibility="{Binding ShowSectionHeaders, Converter={StaticResource BoolToVis}}"
                           Foreground="#6CCB5F"
                           FontWeight="Bold"
                           FontSize="11"
                           Margin="0,2,0,2" />

                <!-- GPU Temperatura -->
                <Grid Visibility="{Binding EffectiveShowGpuTemp, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Temp"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuTemperatureText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- GPU Uso -->
                <Grid Visibility="{Binding EffectiveShowGpuLoad, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Uso"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuLoadText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- GPU Clock -->
                <Grid Visibility="{Binding EffectiveShowGpuClock, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Clock"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuClockText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- GPU Power -->
                <Grid Visibility="{Binding EffectiveShowGpuPower, Converter={StaticResource BoolToVis}}"
                      Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="GPU Power"
                               Foreground="#6CCB5F"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuPowerText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>
            </StackPanel>

            <!-- SEÇÃO RAM -->
            <StackPanel Visibility="{Binding EffectiveShowRam, Converter={StaticResource BoolToVis}}"
                        Margin="0,2,0,0">
                <TextBlock Text="MEMÓRIA"
                           Visibility="{Binding ShowSectionHeaders, Converter={StaticResource BoolToVis}}"
                           Foreground="#C586C0"
                           FontWeight="Bold"
                           FontSize="11"
                           Margin="0,2,0,2" />

                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="RAM"
                               Foreground="#C586C0"
                               FontSize="13" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RamUsageText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Right"
                               Margin="12,0,0,0" />
                </Grid>
            </StackPanel>

        </StackPanel>

        <!-- ==================== LAYOUT HORIZONTAL (EM LINHA) ==================== -->
        <WrapPanel Visibility="{Binding IsHorizontalLayout, Converter={StaticResource BoolToVis}}"
                   Orientation="Horizontal"
                   VerticalAlignment="Center"
                   Margin="{Binding OverlayCardPadding}">

            <!-- FPS -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowFps, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="{Binding FpsText}"
                           Foreground="#FFB900"
                           FontWeight="Bold"
                           FontSize="13" />
            </StackPanel>

            <!-- CPU Temp -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowCpuTemp, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="CPU " Foreground="#60CDFF" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding CpuTemperatureText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- CPU Load -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowCpuLoad, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="CPU " Foreground="#60CDFF" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding CpuLoadText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- CPU Clock -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowCpuClock, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="{Binding CpuClockText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- CPU Power -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowCpuPower, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="{Binding CpuPowerText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- GPU Temp -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowGpuTemp, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="GPU " Foreground="#6CCB5F" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding GpuTemperatureText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- GPU Load -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowGpuLoad, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="GPU " Foreground="#6CCB5F" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding GpuLoadText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- GPU Clock -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowGpuClock, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="{Binding GpuClockText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- GPU Power -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowGpuPower, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="{Binding GpuPowerText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <!-- RAM -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding EffectiveShowRam, Converter={StaticResource BoolToVis}}"
                        Margin="4,0">
                <TextBlock Text="| " Foreground="#44FFFFFF" FontSize="13" />
                <TextBlock Text="RAM " Foreground="#C586C0" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding RamUsageText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

        </WrapPanel>
    </Grid>
</Window>
